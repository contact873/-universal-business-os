{
  "name": "universal-business-os",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant business platform: one shared backend, isolated workspace per business, CRM and leads first.",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "migrate": "node scripts/migrate.mjs",
    "drift": "node scripts/drift.mjs",
    "seed": "node scripts/seed.mjs",
    "verify:http": "node scripts/verify.mjs",
    "verify:isolation": "NODE_ENV=production node scripts/prove-isolation.mjs",
    "verify:all": "node scripts/drift.mjs --selftest && npm run drift && npm test",
    "preflight": "node scripts/preflight-skill.mjs . --env",
    "audit:deps": "node scripts/audit.mjs",
    "sbom": "npm sbom --sbom-format=cyclonedx > sbom.cdx.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.2"
  }
}
