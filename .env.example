# Copy to .env.local and fill in. Never commit real values.

# Signs session cookies. Required in production; the app refuses to start without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the database lives.
#   Local development: leave blank, defaults to ./data/ubos.db
#   Vercel or any serverless host: REQUIRED. Either a libSQL/Turso URL or a Postgres URL.
#   On Vercel the filesystem is read-only and /tmp is per-instance and ephemeral, so the
#   app deliberately refuses to boot without this rather than silently losing customer data.
DATABASE_URL=

# Comma separated. These accounts can reach /admin. Everyone else cannot.
PLATFORM_ADMIN_EMAILS=

# Public origin, used for canonical URLs and redirects.
APP_URL=http://127.0.0.1:3000

# Optional. Outbound email, for invitations and lead notifications.
RESEND_API_KEY=
EMAIL_FROM=

# Billing. All three are optional: with none of them set, the webhook endpoint answers 503 and
# refuses every request rather than trusting an unsigned body, and checkout answers 503 saying no
# provider is connected. That is the intended state until a payment account exists.

# Signs sandbox and self-hosted webhook calls. Also required by scripts/verify.mjs to exercise the
# billing path end to end without a payment provider.
BILLING_WEBHOOK_SECRET=

# Stripe's endpoint secret, from the webhook you create in the Stripe dashboard. Setting this is
# what makes Stripe events accepted.
STRIPE_WEBHOOK_SECRET=

# Present only once the provider adapter that returns a checkout URL is written.
PAYMENT_PROVIDER_KEY=

# The assistant. Same wrapper and defaults as Mia on relcoai.com: Anthropic first, then OpenAI,
# then Moonshot. With none of these set the assistant reports not_configured and hands off to a
# person, rather than failing in front of a customer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
MOONSHOT_API_KEY=
MOONSHOT_MODEL=
MOONSHOT_BASE_URL=

# Optional. Force an order, for example: openai,anthropic
LLM_PROVIDER_ORDER=
